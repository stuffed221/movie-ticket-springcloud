/* pages/order/list.wxss */
.order-card {
  position: relative;
}
.order-no {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 6rpx;
}
.order-movie {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 4rpx;
}
.order-info {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 4rpx;
}
.order-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 10rpx;
}
.order-amount {
  font-size: 36rpx;
  color: #f56c6c;
  font-weight: bold;
}
.order-status {
  font-size: 28rpx;
  font-weight: bold;
}
.status-0 { color: #e6a23c; }
.status-1 { color: #67c23a; }
.status-2 { color: #409EFF; }
.status-3 { color: #999; }
.status-4 { color: #f56c6c; }
.order-time {
  font-size: 22rpx;
  color: #bbb;
  margin-top: 6rpx;
}
.empty {
  text-align: center;
  color: #999;
  padding: 200rpx 0;
}
.order-actions {
  display: flex;
  justify-content: space-between;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f0f0;
}
.action-btn {
  border-radius: 8rpx;
  font-size: 26rpx;
  padding: 0 30rpx;
  height: 60rpx;
  line-height: 60rpx;
  margin: 0;
}
.cancel-btn {
  background: #f5f5f5;
  color: #666;
}
.pay-btn {
  background: #409EFF;
  color: #fff;
}
.refund-btn {
  background: #f56c6c;
  color: #fff;
  margin-left: auto;
}

/* 弹窗 */
.modal-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.5);
  z-index: 100;
}
.modal-card {
  position: fixed;
  top: 80rpx;
  left: 40rpx;
  right: 40rpx;
  background: #fff;
  border-radius: 12rpx;
  padding: 40rpx 30rpx 30rpx;
  z-index: 101;
}
.modal-title {
  text-align: center;
  font-size: 34rpx;
  font-weight: bold;
  margin-bottom: 30rpx;
}
.detail-row {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}
.dl {
  color: #999;
  font-size: 26rpx;
  width: 140rpx;
}
.dv {
  flex: 1;
  font-size: 26rpx;
  color: #333;
  text-align: right;
}
.price {
  color: #f56c6c;
  font-weight: bold;
  font-size: 30rpx;
}
.warn {
  color: #e6a23c;
  font-weight: bold;
}
.modal-close {
  margin-top: 30rpx;
  background: #f5f5f5;
  color: #666;
  font-size: 28rpx;
  border-radius: 8rpx;
}
