/* pages/user/login.wxss */
.login-card {
  margin-top: 120rpx;
  padding: 60rpx 40rpx;
  background: #fff;
  border-radius: 12rpx;
}
.login-title {
  text-align: center;
  font-size: 40rpx;
  font-weight: bold;
  margin-bottom: 60rpx;
}
.login-input {
  border-bottom: 1rpx solid #eee;
  height: 80rpx;
  font-size: 30rpx;
  margin-bottom: 30rpx;
  padding: 0 10rpx;
}
.login-btn {
  width: 100%;
  background: #409EFF;
  color: #fff;
  font-size: 32rpx;
  border-radius: 44rpx;
  margin-top: 40rpx;
}
.switch {
  text-align: center;
  color: #409EFF;
  font-size: 26rpx;
  margin-top: 30rpx;
}

/* 注册弹窗 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.5);
  z-index: 100;
}
.modal-card {
  position: fixed;
  top: 20rpx;
  left: 40rpx;
  right: 40rpx;
  bottom: 40rpx;
  background: #fff;
  border-radius: 12rpx;
  padding: 40rpx 30rpx;
  z-index: 101;
  overflow-y: auto;
}
.modal-title {
  text-align: center;
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 40rpx;
}
.reg-row {
  display: flex;
  align-items: center;
  padding: 10rpx 0;
  border-bottom: 1rpx solid #eee;
  margin-bottom: 30rpx;
}
.reg-label {
  width: 100rpx;
  font-size: 28rpx;
  color: #999;
}
.radio-item {
  margin-right: 40rpx;
  font-size: 28rpx;
}
.phone-row {
  display: flex;
  align-items: center;
  margin-bottom: 30rpx;
}
.phone-input {
  flex: 1;
  border-bottom: 1rpx solid #eee;
  height: 80rpx;
  font-size: 30rpx;
  padding: 0 10rpx;
}
.code-btn {
  width: 180rpx;
  height: 60rpx;
  line-height: 60rpx;
  font-size: 24rpx;
  background: #409EFF;
  color: #fff;
  border-radius: 8rpx;
  margin-left: 16rpx;
  padding: 0;
}
