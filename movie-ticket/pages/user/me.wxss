/* pages/user/me.wxss */
.user-header {
  background: #409EFF;
  padding: 60rpx 40rpx;
  display: flex;
  align-items: center;
  color: #fff;
  margin-bottom: 30rpx;
}
.user-avatar {
  width: 120rpx;
  height: 120rpx;
  background: #fff;
  color: #409EFF;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  font-weight: bold;
  margin-right: 30rpx;
}
.user-name {
  font-size: 36rpx;
}
.menu-item {
  display: flex;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
  font-size: 28rpx;
}
.arrow {
  color: #ccc;
}
.logout-btn, .login-btn {
  width: 80%;
  margin-top: 60rpx;
  border-radius: 44rpx;
}
.logout-btn {
  background: #f5f5f5;
  color: #999;
}
.login-btn {
  background: #409EFF;
  color: #fff;
}
