<!--pages/user/me.wxml-->
<view class="container">
  <view class="user-header">
    <view class="user-avatar">{{firstChar}}</view>
    <view class="user-name">{{userName || '未登录'}}</view>
  </view>

  <view class="card menu-list">
    <view class="menu-item" bindtap="goOrders">
      <text>我的订单</text>
      <text class="arrow">></text>
    </view>
  </view>

  <view wx:if="{{hasToken}}">
    <button class="logout-btn" bindtap="doLogout">退出登录</button>
  </view>
  <view wx:else>
    <button class="login-btn" bindtap="goLogin">去登录</button>
  </view>
</view>
