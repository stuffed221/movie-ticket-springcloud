/* pages/movie/detail.wxss */
.movie-header {
  display: flex;
  background: #fff;
  border-radius: 12rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
}
.poster {
  width: 240rpx;
  height: 340rpx;
  border-radius: 8rpx;
}
.no-poster-detail {
  background: #ddd;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #999;
}
.header-info {
  margin-left: 30rpx;
  flex: 1;
}
.movie-name {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 12rpx;
}
.movie-meta, .movie-actor, .release {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 8rpx;
}
.section-title {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
}
.intro {
  font-size: 28rpx;
  color: #555;
  line-height: 44rpx;
}
.schedule-card {
  position: relative;
}
.schedule-cinema {
  font-size: 30rpx;
  font-weight: bold;
}
.schedule-hall {
  font-size: 24rpx;
  color: #999;
  margin-top: 4rpx;
}
.schedule-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 12rpx;
}
.schedule-time {
  font-size: 28rpx;
  color: #333;
}
.schedule-price {
  font-size: 32rpx;
  color: #f56c6c;
  font-weight: bold;
}
.schedule-seats {
  font-size: 24rpx;
  color: #409EFF;
  margin-top: 8rpx;
}
.empty {
  text-align: center;
  color: #999;
  padding: 60rpx;
}
