/* pages/index/index.wxss */
.search-bar {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
  background: #fff;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
}
.search-input {
  flex: 1;
  height: 60rpx;
  font-size: 28rpx;
}
.search-btn {
  margin-left: 16rpx;
}
.clear-btn {
  margin-left: 8rpx;
  background: #f5f5f5;
  color: #999;
  font-size: 24rpx;
  padding: 0 12rpx;
}
.section-title {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
}
.movie-card {
  display: flex;
}
.movie-poster image {
  width: 160rpx;
  height: 220rpx;
  border-radius: 8rpx;
}
.no-poster {
  width: 160rpx;
  height: 220rpx;
  border-radius: 8rpx;
  background: #ddd;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #999;
}
.movie-info {
  margin-left: 24rpx;
  flex: 1;
}
.movie-name {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
}
.movie-meta {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 8rpx;
}
.movie-actor {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 8rpx;
}
.movie-price {
  font-size: 36rpx;
  color: #f56c6c;
  font-weight: bold;
}
.empty {
  text-align: center;
  color: #999;
  padding: 100rpx;
}
.load-more {
  text-align: center;
  padding: 30rpx;
  color: #409EFF;
  font-size: 28rpx;
}
.no-more {
  text-align: center;
  padding: 30rpx;
  color: #ccc;
  font-size: 24rpx;
}
